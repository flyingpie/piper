<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<add key="local" value="%HOME%/.nuget/local" />
	</packageSources>

	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
		<packageSource key="local">
			<package pattern="Dtr.Blazor.HotReload*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
