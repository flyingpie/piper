@using Piper.UI.Components.CodeEditor

<RadzenStack Orientation="Orientation.Vertical">

	<RadzenSplitter>
		<RadzenSplitterPane Size="70%">

			@* Query Editor *@
			<PpCodeEditor Class="pp-query" Language="sql" @bind-Text="Query"/>

			@* <RadzenTextBox @bind-Value="SearchTerm" /> *@

			@* Table *@
			<RadzenDataGrid

				TItem="PpRecord"

				@ref="_grid"

				AllowAlternatingRows="true"
				AllowColumnPicking="false"
				AllowColumnResize="true"
				AllowFiltering="false"
				AllowMultiColumnSorting="true"
				AllowPaging="true"
				AllowSorting="true"

				Density="Density.Compact"
				FilterMode="FilterMode.SimpleWithMenu"
				LogicalFilterOperator="LogicalFilterOperator.Or"
				PagerHorizontalAlign="HorizontalAlign.Left"
				PageSize="50"
				SelectionMode="DataGridSelectionMode.Single"
				ShowPagingSummary="true"

				Data="@Records"
				Count="@RecordCount"
				LoadData="@LoadDataAsync"
				RowClick="rec => _selectedRec = rec.Data"

			>
				<Columns>

					@foreach (var field in Columns)
					{
						<RadzenDataGridColumn
							TItem="PpRecord"
							Title="@field.Name"
							Width="@GetWidth(field)"
							TextAlign="@(GetAlign(field))"
							Property="@field.Name"
						>
							<Template Context="item">
								@* TODO: Dynamic value thing, with hex color support *@
								@* @switch (field.DataType) *@
								@* { *@
									@* case PpDataType.PpDateTime: *@
										@item.GetValue(field.Name)
										@* break; *@

								@* 	default: *@
								@* 		<Tooltip Text="@(item.GetValue(field.Name)?.ToString())"> *@
								@* 			@item.GetValue(field.Name) *@
								@* 		</Tooltip> *@
								@* 		break; *@
								@* } *@
							</Template>
						</RadzenDataGridColumn>
					}

				</Columns>
			</RadzenDataGrid>

		</RadzenSplitterPane>
		<RadzenSplitterPane>

			<RadzenTabs TabPosition="TabPosition.Right">
				<Tabs>

					@* Row Details *@
					<RadzenTabsItem Icon="table">

						@if (_selectedRec is not null)
						{
							<RadzenStack Orientation="Orientation.Vertical">
								@foreach (var field in _selectedRec.Fields)
								{
									@field.Key
									<DynamicTextBox Value="@field.Value.ValueAsString" />
									@* <RadzenFormField Text="@field.Key"> *@
										@* <RadzenTextBox Value="@field.Value.ValueAsString" /> *@

									// </RadzenFormField>
								}
							</RadzenStack>
						}

					</RadzenTabsItem>

					@* Columns *@
					<RadzenTabsItem Icon="table">

					</RadzenTabsItem>
				</Tabs>
			</RadzenTabs>

		</RadzenSplitterPane>
	</RadzenSplitter>
</RadzenStack>

<style>
	.pp-query .monaco-editor-container {
		height: 50px !important;
	}
</style>