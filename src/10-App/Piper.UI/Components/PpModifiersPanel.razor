@using Piper.UI.Components.Modifiers
@using Piper.UI.Services

<RadzenStack>

	<!-- Panel header -->
	<RadzenMenu Click="a => AddModifier(a.Value?.ToString())">
		<RadzenMenuItem Text="Add">
			<RadzenMenuItem Text="Casing"	Value="@("PP_MOD_CASING")" />
			<RadzenMenuItem Text="Remove"	Value="@("PP_MOD_REMOVE")" />
			<RadzenMenuItem Text="Replace"	Value="@("PP_MOD_REPLACE")" />
			<RadzenMenuItem Text="Reverse"	Value="@("PP_MOD_REVERSE")" />
			<RadzenMenuItem Text="Select"	Value="@("PP_MOD_SELECT")" />
			<RadzenMenuItem Text="XPath"	Value="@("PP_MOD_XPATH")" />
		</RadzenMenuItem>
	</RadzenMenu>

	<RadzenStack Orientation="Orientation.Vertical">

		@foreach (var mod in SelectedThingyService.Instance?.SelectedPort?.Modifiers?.Modifiers ?? [])
		{
			<RadzenStack Orientation="Orientation.Vertical" Gap=".5em" class="rz-p-2">

				<!-- Modifier header -->
				<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5em" class="rz-background-color-base-900 rz-p-2">

					<RadzenButton
						Icon="keyboard_arrow_up" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined" />

					<RadzenButton
						Icon="keyboard_arrow_down" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined" />

					<span style="flex: 1;">@mod.Name</span>

					<RadzenButton
						Icon="menu"
						Size="ButtonSize.ExtraSmall"
						Variant="Variant.Outlined"
					/>

					<RadzenButton
						Click="async () => await (SelectedThingyService.Instance?.SelectedPort?.Modifiers?.ExecuteAsync() ?? Task.CompletedTask)"
						Icon="play_arrow"
						Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined" />

					<RadzenButton
						Click="() => RemoveModifier(mod)"
						Text="X" Size="ButtonSize.ExtraSmall" Variant="Variant.Outlined" />
				</RadzenStack>

				<!-- Modifier properties -->
				<GenericModifierView Modifier="mod" />
			</RadzenStack>
		}

	</RadzenStack>

</RadzenStack>
