@*
Dynamic text box, showing an editor for the specified PpField, taking into account any data type flags.

I.e., applies highlighting based on the text format, and makes the editor higher for multi-line content.
*@

@using Piper.UI.Components.CodeEditor

@switch (Field?.DataTypeFlags ?? PpDataTypeFlags.None)
{
	@* Hex color *@
	case PpDataTypeFlags.HexColor:
		<RadzenTextBox Style="@($"background-color: {Field?.ValueAsString}; font-family: monospace; text-shadow: 1px 1px 2px black;")" Value="@Field?.ValueAsString" />
		break;

	@* JSON *@
	case PpDataTypeFlags.Json:
		<PpCodeEditor Class="pp-dyn-textbox long" Language="json" Text="@Field?.ValueAsString"/>
		break;

	@* Multi-Line *@
	case PpDataTypeFlags.MultiLine:
		<PpCodeEditor Class="pp-dyn-textbox long" Language="http" Text="@Field?.ValueAsString"/>
		break;

	@* XML *@
	case PpDataTypeFlags.Xml:
		<PpCodeEditor Class="pp-dyn-textbox long" Language="xml" Text="@Field?.ValueAsString"/>
		break;

	@* Anything else *@
	default:
		if (Field?.Value is List<string> stringList)
		{
			<RadzenStack Orientation="Orientation.Vertical">
				@foreach (var str in stringList)
				{
					@* <div>@(string.Join(", ", stringList))</div> *@
					<RadzenTextBox Value="@str" />
				}
			</RadzenStack>
		}
		else
		{
			<RadzenTextBox Value="@Field?.ValueAsString" />
		}
		break;
}

@code {

	[Parameter]
	public PpField? Field { get; set; }

}

<style>
	.pp-dyn-textbox.long .monaco-editor-container {
		height: 150px !important;
	}
</style>
