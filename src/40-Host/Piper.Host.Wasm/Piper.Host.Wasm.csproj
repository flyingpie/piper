<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
	<PropertyGroup>
		<AssemblyName>Piper.Host.Wasm</AssemblyName>
		<RootNamespace>Piper.Host.Wasm</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\10-Core\Piper\Piper.csproj" />
		<ProjectReference Include="..\..\20-UI\Piper.UI\Piper.UI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<GraphsDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../graphs'))</GraphsDir>
		<WasmGraphsDir>$(MSBuildProjectDirectory)/wwwroot/graphs</WasmGraphsDir>
	</PropertyGroup>

	<!--
		The sample graphs live at the repository root (shared with the other hosts), but the static web asset pipeline
		only serves files under the project's "wwwroot". Copy them in, plus an index the WASM app can read (a browser
		can't enumerate the file system), before static web assets are discovered.
	-->
	<Target Name="PrepareGraphs" BeforeTargets="ResolveProjectStaticWebAssets">
		<ItemGroup>
			<_GraphSource Include="$(GraphsDir)/*.json" />
		</ItemGroup>

		<Copy SourceFiles="@(_GraphSource)" DestinationFolder="$(WasmGraphsDir)" SkipUnchangedFiles="true" />

		<PropertyGroup>
			<_GraphsIndex>[@(_GraphSource->'&quot;%(Filename)%(Extension)&quot;', ',')]</_GraphsIndex>
		</PropertyGroup>

		<WriteLinesToFile File="$(WasmGraphsDir)/index.json" Lines="$(_GraphsIndex)" Overwrite="true" WriteOnlyWhenDifferent="true" />

		<ItemGroup>
			<Content Include="wwwroot/graphs/*.json" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Update="CSharpier.MSBuild">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference
			Update="Microsoft.VisualStudio.Threading.Analyzers"
			PrivateAssets="all"
			IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
		/>
		<PackageReference
			Update="SonarAnalyzer.CSharp"
			PrivateAssets="all"
			IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
		/>
	</ItemGroup>
</Project>
